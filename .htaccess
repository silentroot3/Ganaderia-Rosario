RewriteEngine On
RewriteBase /

# ============================================
# MÓDULOS - URLs LIMPIAS
# ============================================
RewriteRule ^dashboard/?$ modules/dashboard/index.php [L,QSA]
RewriteRule ^recepcion/?$ modules/recepcion/index.php [L,QSA]
RewriteRule ^recepcion/crear/?$ modules/recepcion/crear.php [L,QSA]
RewriteRule ^recepcion/bovinos/?$ modules/recepcion/bovinos.php [L,QSA]
RewriteRule ^recepcion/detalle/?$ modules/recepcion/detalle.php [L,QSA]
RewriteRule ^recepcion/exportar/?$ modules/recepcion/exportar.php [L,QSA]
RewriteRule ^bovinos/?$ modules/bovinos/index.php [L,QSA]

# ============================================
# MODULO VETERINARIO (sanidad)
# ============================================
RewriteRule ^sanidad/?$                 modules/sanidad/index.php [L,QSA]
RewriteRule ^sanidad/atender/?$         modules/sanidad/atender.php [L,QSA]
RewriteRule ^sanidad/alta/?$            modules/sanidad/alta.php [L,QSA]
RewriteRule ^sanidad/historial/?$       modules/sanidad/historial.php [L,QSA]
RewriteRule ^sanidad/tratamiento/?$     modules/sanidad/tratamiento.php [L,QSA]



RewriteRule ^clasificacion/?$ modules/clasificacion/index.php [L,QSA]
RewriteRule ^corrales/?$ modules/corrales/index.php [L,QSA]
RewriteRule ^alimentacion/?$ modules/alimentacion/index.php [L,QSA]
RewriteRule ^tratamientos/?$ modules/tratamientos/index.php [L,QSA]
RewriteRule ^seguimiento/?$ modules/seguimiento/index.php [L,QSA]
RewriteRule ^costos/?$ modules/costos/index.php [L,QSA]
RewriteRule ^ventas/?$ modules/ventas/index.php [L,QSA]
RewriteRule ^reportes/?$ modules/reportes/index.php [L,QSA]
RewriteRule ^trazabilidad/?$ modules/trazabilidad/index.php [L,QSA]
RewriteRule ^alertas/?$ modules/alertas/index.php [L,QSA]
RewriteRule ^usuarios/?$ modules/usuarios/index.php [L,QSA]
RewriteRule ^configuracion/?$ modules/configuracion/index.php [L,QSA]

# ============================================
# ERRORES
# ============================================
RewriteRule ^403/?$ modules/errors/403.php [L,QSA]

# ============================================
# AUTH
# ============================================
RewriteRule ^login/?$ modules/auth/login.php [L,QSA]
RewriteRule ^logout/?$ modules/auth/logout.php [L,QSA]

# ============================================
# REDIRIGIR LA RAÍZ
# ============================================
RewriteRule ^$ index.php [L,QSA]

# ============================================
# FALLBACK (última regla)
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]
