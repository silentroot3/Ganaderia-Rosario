<script>
function actualizarCategoria() {
    const sexo = document.getElementById('sexo').value;
    const peso = parseFloat(document.getElementById('peso').value);
    const preview = document.getElementById('categoriaPreview');
    const estadoBovino = document.querySelector('input[name="estado_bovino"]:checked').value;
    
    if (estadoBovino !== 'vivo' || !sexo || !peso || peso <= 0) {
        preview.style.display = 'none';
        return;
    }
    
    const precios = {
        'M': [
            {min: 120, max: 170, precio: 92, cat: 'Becerro', corral: 'M-1'},
            {min: 171, max: 200, precio: 90, cat: 'Becerro', corral: 'M-1'},
            {min: 201, max: 230, precio: 86, cat: 'Ternero', corral: 'M-2'},
            {min: 231, max: 250, precio: 83, cat: 'Ternero', corral: 'M-2'},
            {min: 251, max: 300, precio: 78, cat: 'Novillo', corral: 'M-3'},
            {min: 301, max: 350, precio: 0, cat: 'Adulto', corral: 'M-4'}
        ],
        'H': [
            {min: 120, max: 200, precio: 84, cat: 'Becerro', corral: 'H-1'},
            {min: 201, max: 230, precio: 81, cat: 'Ternero', corral: 'H-2'},
            {min: 231, max: 250, precio: 78, cat: 'Novillo', corral: 'H-2'},
            {min: 251, max: 300, precio: 78, cat: 'Novillo', corral: 'H-3'},
            {min: 301, max: 350, precio: 0, cat: 'Adulto', corral: 'H-4'}
        ]
    };
    
    let encontrado = null;
    for (const r of precios[sexo]) {
        if (peso >= r.min && peso <= r.max) {
            encontrado = r;
            break;
        }
    }
    
    if (encontrado) {
        const total = (encontrado.precio * peso).toFixed(2);
        preview.innerHTML = 'Categoria: <strong>' + encontrado.cat + '</strong> | Corral sugerido: <strong>' + encontrado.corral + '</strong> | Precio/kg: <strong>$' + encontrado.precio + '</strong> | Valor: <strong>$' + Number(total).toLocaleString('es-MX', {minimumFractionDigits: 2}) + ' MXN</strong>';
        preview.style.background = '#d4edda';
        preview.style.color = '#155724';
    } else {
        preview.innerHTML = 'Peso fuera de rango (120-350 kg)';
        preview.style.background = '#fff3cd';
        preview.style.color = '#856404';
    }
    preview.style.display = 'block';
}

function toggleHospital() {
    const checkbox = document.getElementById('es_enfermo');
    const fields = document.getElementById('hospitalFields');
    const motivo = document.getElementById('motivo_hospital');
    
    if (checkbox.checked) {
        fields.style.display = 'block';
        motivo.required = true;
    } else {
        fields.style.display = 'none';
        motivo.required = false;
        motivo.value = '';
    }
}

function toggleEstado() {
    const estadoBovino = document.querySelector('input[name="estado_bovino"]:checked').value;
    const vivoFields = document.getElementById('vivoFields');
    const bajaFields = document.getElementById('bajaFields');
    const motivoBaja = document.getElementById('motivo_baja');
    const preview = document.getElementById('categoriaPreview');
    
    if (estadoBovino === 'vivo') {
        vivoFields.style.display = 'block';
        bajaFields.style.display = 'none';
        motivoBaja.required = false;
        actualizarCategoria();
    } else {
        vivoFields.style.display = 'none';
        bajaFields.style.display = 'block';
        motivoBaja.required = true;
        preview.style.display = 'none';
    }
}
</script>

