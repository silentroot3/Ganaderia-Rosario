require_once __DIR__ . '/../../includes/categorizacion.php';
require_once __DIR__ . '/../../includes/generar_archivos.php';
require_once __DIR__ . '/../../includes/asignacion_corrales.php';

$recepcion_id = (int)($_GET['id'] ?? 0);
if (!$recepcion_id) {
    header('Location: ' . BASE_URL . '/recepcion');
    exit;
}

if (!isset($_SESSION['user_id'])) {
    header('Location: ' . BASE_URL . '/login');
    exit;
}

$error = '';
$exito = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $db = Database::getInstance()->getConnection();
        $accion = $_POST['accion'] ?? '';
        
        // ============================================
        // AGREGAR BOVINO
        // ============================================
        if ($accion === 'agregar') {
            $id_siniiga = trim($_POST['id_siniiga'] ?? '');
            $sexo = $_POST['sexo'] ?? '';
            $raza = trim($_POST['raza'] ?? '');
            $peso = (float)($_POST['peso_entrada'] ?? 0);
            $edad = (int)($_POST['edad_meses'] ?? 0);
            $color = trim($_POST['color'] ?? '');
            $observaciones = trim($_POST['observaciones'] ?? '');
            $esEnfermo = isset($_POST['es_enfermo']) && $_POST['es_enfermo'] == '1';
            $motivoHospital = trim($_POST['motivo_hospital'] ?? '');
            
            if (!preg_match('/^\d{12}$/', $id_siniiga)) {
                throw new Exception('El ID SINIIGA debe tener exactamente 12 digitos');
            }
            if (!in_array($sexo, ['M', 'H'])) {
                throw new Exception('Debe seleccionar Macho o Hembra');
            }
            if ($peso <= 0) {
                throw new Exception('El peso debe ser mayor a 0');
            }
            if ($esEnfermo && empty($motivoHospital)) {
                throw new Exception('Debe indicar el motivo para enviar a hospital');
            }
            
            $stmt = $db->prepare("SELECT id FROM bovinos WHERE id_siniiga = ?");
            $stmt->execute([$id_siniiga]);
            if ($stmt->fetch()) {
                throw new Exception('El SINIIGA ' . $id_siniiga . ' ya esta registrado');
            }
            
            $corral = encontrarCorralAdecuado($sexo, $peso, $esEnfermo);
            if (!$corral) {
                $tipoCorral = $esEnfermo ? 'hospital' : 'corral';
                throw new Exception("No hay {$tipoCorral} disponible para " . 
                    ($sexo === 'M' ? 'macho' : 'hembra') . " de {$peso} kg");
            }
            
            $cat = categorizarBovino($sexo, $peso);
            
            $stmt = $db->prepare("
                INSERT INTO bovinos 
                (recepcion_id, id_siniiga, sexo, raza, peso_entrada, categoria, edad_meses, color, observaciones, 
                 estado, corral_id, corral_original_id, en_hospital, motivo_hospital, fecha_entrada_hospital)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ");
            
            $estado = $esEnfermo ? 'en_cuarentena' : 'en_corral';
            $corralOriginal = $esEnfermo ? null : $corral['id'];
            $enHospital = $esEnfermo ? 1 : 0;
            $fechaHospital = $esEnfermo ? date('Y-m-d H:i:s') : null;
            
            $stmt->execute([
                $recepcion_id, $id_siniiga, $sexo, $raza, $peso, 
                $cat['subcategoria'], $edad, $color, $observaciones,
                $estado, $corral['id'], $corralOriginal, $enHospital, 
                $motivoHospital ?: null, $fechaHospital
            ]);
            
            $bovino_id = $db->lastInsertId();
            
            $db->prepare("UPDATE corrales SET ocupacion_actual = ocupacion_actual + 1 WHERE id = ?")
               ->execute([$corral['id']]);
            
            $tipoMov = $esEnfermo ? 'hospital' : 'clasificacion';
            $motivoMov = $esEnfermo ? $motivoHospital : 'Asignacion automatica por sexo/peso';
            
            $db->prepare("
                INSERT INTO movimientos_bovino 
                (bovino_id, corral_origen_id, corral_destino_id, tipo_movimiento, motivo, usuario_id, fecha)
                VALUES (?, NULL, ?, ?, ?, ?, NOW())
            ")->execute([$bovino_id, $corral['id'], $tipoMov, $motivoMov, $_SESSION['user_id']]);
            
            if ($esEnfermo) {
                $exito = "Bovino {$id_siniiga} enviado a {$corral['nombre']} por: {$motivoHospital}";
            } else {
                $exito = "Bovino {$id_siniiga} asignado a {$corral['nombre']} ({$cat['nombre_completo']} - \${$cat['precio_kg']}/kg)";
            }
        }
        
        // ============================================
        // REGISTRAR BAJA
        // ============================================
        if ($accion === 'baja') {
            $tipo = $_POST['tipo_baja'] ?? '';
            $cantidad = (int)($_POST['cantidad_baja'] ?? 0);
            $motivo = trim($_POST['motivo_baja'] ?? '');
            $observaciones = trim($_POST['observaciones_baja'] ?? '');
            
            if (!in_array($tipo, ['muerte', 'devolucion', 'rechazo'])) {
                throw new Exception('Tipo de baja invalido');
            }
            if ($cantidad <= 0) {
                throw new Exception('La cantidad debe ser mayor a 0');
            }
            if (empty($motivo)) {
                throw new Exception('El motivo es obligatorio');
            }
            
            $stmt = $db->prepare("
                INSERT INTO bajas_recepcion 
                (recepcion_id, tipo, cantidad, motivo, observaciones, usuario_id)
                VALUES (?, ?, ?, ?, ?, ?)
            ");
            $stmt->execute([
                $recepcion_id, $tipo, $cantidad, $motivo, $observaciones, $_SESSION['user_id']
            ]);
            
            $tipoLabel = $tipo === 'muerte' ? 'muerte(s)' : 
                        ($tipo === 'devolucion' ? 'devolucion(es)' : 'rechazo(s)');
            $exito = "Baja registrada: {$cantidad} {$tipoLabel} - Motivo: {$motivo}";
        }
        
        // ============================================
        // FINALIZAR RECEPCION
        // ============================================
        if ($accion === 'finalizar') {
            $stmt = $db->prepare("SELECT COUNT(*) FROM bovinos WHERE recepcion_id = ?");
            $stmt->execute([$recepcion_id]);
            $total = $stmt->fetchColumn();
            
            if ($total == 0) {
                throw new Exception('Debe registrar al menos un bovino');
            }
            
            $stmt = $db->prepare("
                SELECT SUM(peso_entrada) AS peso_total, COUNT(*) AS total_bovinos
                FROM bovinos WHERE recepcion_id = ?
            ");
            $stmt->execute([$recepcion_id]);
            $totales = $stmt->fetch(PDO::FETCH_ASSOC);
            
            $stmt = $db->prepare("SELECT IFNULL(SUM(cantidad), 0) FROM bajas_recepcion WHERE recepcion_id = ?");
            $stmt->execute([$recepcion_id]);
            $totalBajas = $stmt->fetchColumn();
            
            $db->prepare("
                UPDATE recepciones 
                SET estado = 'completado',
                    cantidad_recibida = ?,
                    cantidad_bajas = ?,
                    peso_total_recibido = ?
                WHERE id = ?
            ")->execute([
                $totales['total_bovinos'],
                $totalBajas,
                $totales['peso_total'] ?? 0,
                $recepcion_id
            ]);
            
            $stmt = $db->prepare("
                SELECT r.*, p.nombre AS proveedor_nombre
                FROM recepciones r
                LEFT JOIN proveedores p ON r.proveedor_id = p.id
                WHERE r.id = ?
            ");
            $stmt->execute([$recepcion_id]);
            $recepcion = $stmt->fetch(PDO::FETCH_ASSOC);
            
            $stmt = $db->prepare("SELECT * FROM bovinos WHERE recepcion_id = ?");
            $stmt->execute([$recepcion_id]);
            $bovinos = $stmt->fetchAll(PDO::FETCH_ASSOC);
            
            $stmt = $db->prepare("SELECT * FROM bajas_recepcion WHERE recepcion_id = ?");
            $stmt->execute([$recepcion_id]);
            $bajas = $stmt->fetchAll(PDO::FETCH_ASSOC);
            
            $archivo = generarActaRecepcion($recepcion_id, $bovinos, $bajas, $recepcion);
            generarArchivoCSV($recepcion_id, $bovinos, $recepcion);
            
            header('Location: ' . BASE_URL . '/recepcion/detalle?id=' . $recepcion_id . '&archivo=' . urlencode($archivo['nombre']));
            exit;
        }
        
    } catch (Exception $e) {
        $error = $e->getMessage();
    }
}

$titulo = 'Registrar Bovinos';
$modulo = 'recepcion';
$accion = 'crear';
require_once __DIR__ . '/../../includes/header.php';

$db = Database::getInstance()->getConnection();

$stmt = $db->prepare("
    SELECT r.*, 
           p.nombre AS proveedor_nombre,
           u.nombre AS usuario_nombre,
           u.apellido AS usuario_apellido
    FROM recepciones r
    LEFT JOIN proveedores p ON r.proveedor_id = p.id
    LEFT JOIN usuarios u ON r.usuario_id = u.id
    WHERE r.id = ?
");
$stmt->execute([$recepcion_id]);
$recepcion = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$recepcion) {
    header('Location: ' . BASE_URL . '/recepcion');
    exit;
}

$stmt = $db->prepare("
    SELECT b.*, c.nombre AS corral_nombre, c.tipo AS corral_tipo
    FROM bovinos b
    LEFT JOIN corrales c ON b.corral_id = c.id
    WHERE b.recepcion_id = ? 
    ORDER BY b.id
");
$stmt->execute([$recepcion_id]);
$bovinos = $stmt->fetchAll(PDO::FETCH_ASSOC);

$stmt = $db->prepare("SELECT * FROM bajas_recepcion WHERE recepcion_id = ? ORDER BY id DESC");
$stmt->execute([$recepcion_id]);
$bajas = $stmt->fetchAll(PDO::FETCH_ASSOC);

$pesoTotal = 0;
$valorTotal = 0;
$enHospital = 0;
foreach ($bovinos as $b) {
    $pesoTotal += $b['peso_entrada'];
    $cat = categorizarBovino($b['sexo'], $b['peso_entrada']);
    $valorTotal += $cat['precio_total'];
    if ($b['en_hospital']) $enHospital++;
}

$totalBajas = 0;
foreach ($bajas as $bj) {
    $totalBajas += $bj['cantidad'];
}
