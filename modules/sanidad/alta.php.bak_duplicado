require_once __DIR__ . '/../../includes/config.php';
require_once __DIR__ . '/../../includes/categorizacion.php';
require_once __DIR__ . '/../../includes/asignacion_corrales.php';

$bovino_id = (int)($_GET['id'] ?? 0);
if (!$bovino_id) {
    header('Location: ' . BASE_URL . '/sanidad');
    exit;
}

if (!isset($_SESSION['user_id'])) {
    header('Location: ' . BASE_URL . '/login');
    exit;
}

$error = '';
$exito = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $db = Database::getInstance()->getConnection();
        
        $corral_destino = (int)($_POST['corral_destino'] ?? 0);
        $notas = trim($_POST['notas'] ?? '');
        
        if (!$corral_destino) {
            throw new Exception('Debe seleccionar un corral de destino');
        }
        
        // Verificar que el corral existe y tiene espacio
        $stmt = $db->prepare("
            SELECT * FROM corrales 
            WHERE id = ? AND es_hospital = 0 AND es_venta = 0
              AND ocupacion_actual < capacidad_maxima
        ");
        $stmt->execute([$corral_destino]);
        $corral = $stmt->fetch(PDO::FETCH_ASSOC);
        
        if (!$corral) {
            throw new Exception('El corral seleccionado no esta disponible');
        }
        
        // Obtener datos del bovino
        $stmt = $db->prepare("SELECT corral_id, corral_original_id FROM bovinos WHERE id = ?");
        $stmt->execute([$bovino_id]);
        $bovino = $stmt->fetch(PDO::FETCH_ASSOC);
        
        $hospital_actual = $bovino['corral_id'];
        
        // Actualizar bovino: sacar de hospital, asignar corral destino
        $db->beginTransaction();
        
        $db->prepare("
            UPDATE bovinos 
            SET corral_id = ?,
                en_hospital = 0,
                motivo_hospital = NULL,
                fecha_salida_hospital = NOW(),
                estado = 'en_corral'
            WHERE id = ?
        ")->execute([$corral_destino, $bovino_id]);
        
        // Actualizar ocupacion del hospital (baja)
        if ($hospital_actual) {
            $db->prepare("UPDATE corrales SET ocupacion_actual = GREATEST(ocupacion_actual - 1, 0) WHERE id = ?")
               ->execute([$hospital_actual]);
        }
        
        // Actualizar ocupacion del corral destino (sube)
        $db->prepare("UPDATE corrales SET ocupacion_actual = ocupacion_actual + 1 WHERE id = ?")
           ->execute([$corral_destino]);
        
        // Registrar movimiento
        $db->prepare("
            INSERT INTO movimientos_bovino 
            (bovino_id, corral_origen_id, corral_destino_id, tipo_movimiento, motivo, usuario_id, fecha)
            VALUES (?, ?, ?, 'alta', ?, ?, NOW())
        ")->execute([
            $bovino_id, 
            $hospital_actual, 
            $corral_destino, 
            $notas ?: 'Alta medica - recuperado',
            $_SESSION['user_id']
        ]);
        
        $db->commit();
        
        $exito = "Bovino dado de alta. Asignado a {$corral['nombre']}";
        
        header('refresh:2;url=' . BASE_URL . '/sanidad/historial?id=' . $bovino_id);
        
    } catch (Exception $e) {
        if (isset($db) && $db->inTransaction()) {
            $db->rollBack();
        }
        $error = $e->getMessage();
    }
}

